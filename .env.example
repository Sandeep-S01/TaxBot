# Anthropic API credentials
ANTHROPIC_API_KEY=sk-ant-...

# Gemini API credentials (used for Gemini 2.5 Flash receipt/document/audio flows)
GEMINI_API_KEY=your_gemini_api_key

# Supabase database configuration
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Server-side security secrets. Use long random values (32+ characters).
JWT_SECRET=replace_with_32_plus_character_random_secret
EXPORT_TOKEN_SECRET=replace_with_32_plus_character_random_secret

# Meta WhatsApp Cloud API credentials
WA_TOKEN=your_meta_permanent_token
WA_PHONE_ID=your_whatsapp_phone_number_id
WA_VERIFY_TOKEN=any_random_string_you_choose
META_APP_SECRET=your_meta_app_secret_from_app_basic_settings

# Sandbox.co.in GST API credentials
SANDBOX_API_KEY=your_sandbox_co_in_key

# Express server config
PORT=3000
NODE_ENV=development

# Production smoke test configuration for npm run smoke:prod
SMOKE_BASE_URL=https://your-deployed-taxbot.example.com
SMOKE_CA_EMAIL=ca@example.com
SMOKE_CA_PASSWORD=replace_with_test_ca_password
